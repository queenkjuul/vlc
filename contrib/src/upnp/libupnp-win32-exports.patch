From 32d44beab80bed4766ff2c25dc77132d754650a7 Mon Sep 17 00:00:00 2001
From: Alaric Senat <dev.asenat@posteo.net>
Date: Mon, 28 Mar 2022 17:19:55 +0200
Subject: [PATCH] libupnp win32 exports

---
 configure.ac  | 7 +++++++
 libupnp.pc.in | 2 +-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/configure.ac b/configure.ac
index 35c060cc..76f48486 100644
--- a/configure.ac
+++ b/configure.ac
@@ -509,6 +509,13 @@ AX_PTHREAD(
 CC="$PTHREAD_CC"
 CFLAGS="$PTHREAD_CFLAGS $CFLAGS"
 LIBS="$PTHREAD_LIBS $LIBS"
+
+# WIN32 specific
+if test "$ac_cv_win32" = "yes"; then
+WIN32_LIBS="-liphlpapi -lws2_32"
+fi
+AC_SUBST(WIN32_LIBS)
+
 #
 # Determine if pthread_rwlock_t is available
 #
diff --git a/libupnp.pc.in b/libupnp.pc.in
index 8c6fc22f..ccdaf871 100644
--- a/libupnp.pc.in
+++ b/libupnp.pc.in
@@ -6,7 +6,7 @@ includedir=@includedir@
 Name: libupnp
 Description: Linux SDK for UPnP Devices
 Version: @VERSION@
-Libs: @PTHREAD_CFLAGS@ @PTHREAD_LIBS@ -L${libdir} -lupnp -lixml
+Libs: -L${libdir} -lupnp -lixml @PTHREAD_CFLAGS@ @PTHREAD_LIBS@ @WIN32_LIBS@
 Libs.private: @OPENSSL_LIBS@
 Cflags: @PTHREAD_CFLAGS@ -I${includedir}/upnp
 
-- 
2.35.1

