From 411a5ce5afd9fe0ed814e8ee361e02e1864977e9 Mon Sep 17 00:00:00 2001
From: Alaric Senat <alaric@videolabs.io>
Date: Fri, 29 Nov 2024 15:30:22 +0100
Subject: [PATCH] implement stream read without libdvdcss

---
 src/dvd_input.c | 45 ++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 40 insertions(+), 5 deletions(-)

diff --git a/src/dvd_input.c b/src/dvd_input.c
index d7dad87..0e42cb1 100644
--- a/src/dvd_input.c
+++ b/src/dvd_input.c
@@ -25,6 +25,8 @@
 #include <fcntl.h>                               /* open */
 #include <unistd.h>                              /* lseek */
 #include <string.h>                  /* strerror */
+#include <assert.h>
+#include <stdbool.h>
 #include <errno.h>
 
 #ifdef _WIN32
@@ -103,6 +105,8 @@ struct dvd_input_s {
 
   /* dummy file input */
   int fd;
+  dvd_reader_stream_cb *stream_cb;
+  off_t cursor;
 };
 
 static dvd_input_t dvd_input_New(void *priv, dvd_logger_cb *logcb)
@@ -199,11 +203,11 @@ static int css_close(dvd_input_t dev)
  */
 static dvd_input_t file_open(void *priv, dvd_logger_cb *logcb,
                              const char *target,
-                             dvd_reader_stream_cb *stream_cb UNUSED)
+                             dvd_reader_stream_cb *stream_cb)
 {
   dvd_input_t dev;
 
-  if(target == NULL)
+  if(stream_cb == NULL && target == NULL)
     return NULL;
   /* Allocate the library structure */
   dev = dvd_input_New(priv, logcb);
@@ -213,6 +217,11 @@ static dvd_input_t file_open(void *priv, dvd_logger_cb *logcb,
     return NULL;
   }
 
+  if (stream_cb != NULL){
+      dev->stream_cb = stream_cb;
+      return dev;
+  }
+
   /* Open the device */
 #if defined(_WIN32)
   dev->fd = open_win32(target, O_RDONLY | O_BINARY);
@@ -256,6 +265,17 @@ static int file_seek(dvd_input_t dev, int blocks)
 {
   off_t pos;
 
+  if (dev->stream_cb != NULL) {
+      if (dev->stream_cb->pf_seek == NULL)
+      {
+          DVDReadLog(dev->priv, dev->logcb, DVD_LOGGER_LEVEL_WARN, "ded");
+          return 0;
+      }
+      dev->cursor = (off_t)blocks * (off_t)DVD_VIDEO_LB_LEN;
+      dev->stream_cb->pf_seek(dev->priv, dev->cursor);
+      return blocks;
+  }
+
   pos = lseek(dev->fd, (off_t)blocks * (off_t)DVD_VIDEO_LB_LEN, SEEK_SET);
   if(pos < 0) {
     return pos;
@@ -284,7 +304,11 @@ static int file_read(dvd_input_t dev, void *buffer, int blocks,
   bytes = 0;
 
   while(len > 0) {
-    ssize_t ret = read(dev->fd, ((char*)buffer) + bytes, len);
+    ssize_t ret;
+    if (dev->stream_cb != NULL)
+        ret = dev->stream_cb->pf_read(dev->priv, ((char*)buffer) + bytes, len);
+    else
+        ret = read(dev->fd, ((char*)buffer) + bytes, len);
 
     if(ret < 0) {
       /* One of the reads failed, too bad.  We won't even bother
@@ -296,8 +320,18 @@ static int file_read(dvd_input_t dev, void *buffer, int blocks,
     if(ret == 0) {
       /* Nothing more to read.  Return all of the whole blocks, if any.
        * Adjust the file position back to the previous block boundary. */
-      off_t over_read = -(bytes % DVD_VIDEO_LB_LEN);
-      off_t pos = lseek(dev->fd, over_read, SEEK_CUR);
+      const off_t over_read = -(bytes % DVD_VIDEO_LB_LEN);
+      off_t pos;
+      if (dev->stream_cb != NULL) {
+        dev->cursor -= over_read;
+        dev->stream_cb->pf_seek(dev->priv, dev->cursor);
+        pos = dev->cursor;
+      }
+      else {
+        pos = lseek(dev->fd, over_read, SEEK_CUR);
+      }
+
+      //off_t pos = file_seek(dev, over_read);
       if(pos % 2048 != 0)
           DVDReadLog(dev->priv, dev->logcb, DVD_LOGGER_LEVEL_WARN,
                      "lseek not multiple of 2048! Something is wrong!");
@@ -306,6 +340,7 @@ static int file_read(dvd_input_t dev, void *buffer, int blocks,
 
     len -= ret;
     bytes += ret;
+    dev->cursor += ret;
   }
 
   return blocks;
-- 
2.47.0

