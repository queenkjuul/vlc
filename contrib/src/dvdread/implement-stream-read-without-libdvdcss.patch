From fe6541014d948ddefd11ad2b290541fbc455e427 Mon Sep 17 00:00:00 2001
From: Alaric Senat <alaric@videolabs.io>
Date: Fri, 27 Sep 2024 10:10:47 +0200
Subject: [PATCH] implement stream read without libdvdcss

---
 src/dvd_input.c | 30 +++++++++++++++++++++++++++---
 1 file changed, 27 insertions(+), 3 deletions(-)

diff --git a/src/dvd_input.c b/src/dvd_input.c
index d7dad87..f2cd51f 100644
--- a/src/dvd_input.c
+++ b/src/dvd_input.c
@@ -25,6 +25,8 @@
 #include <fcntl.h>                               /* open */
 #include <unistd.h>                              /* lseek */
 #include <string.h>                  /* strerror */
+#include <assert.h>
+#include <stdbool.h>
 #include <errno.h>
 
 #ifdef _WIN32
@@ -103,6 +105,7 @@ struct dvd_input_s {
 
   /* dummy file input */
   int fd;
+  dvd_reader_stream_cb *stream_cb;
 };
 
 static dvd_input_t dvd_input_New(void *priv, dvd_logger_cb *logcb)
@@ -199,11 +202,11 @@ static int css_close(dvd_input_t dev)
  */
 static dvd_input_t file_open(void *priv, dvd_logger_cb *logcb,
                              const char *target,
-                             dvd_reader_stream_cb *stream_cb UNUSED)
+                             dvd_reader_stream_cb *stream_cb)
 {
   dvd_input_t dev;
 
-  if(target == NULL)
+  if(stream_cb == NULL && target == NULL)
     return NULL;
   /* Allocate the library structure */
   dev = dvd_input_New(priv, logcb);
@@ -213,6 +216,11 @@ static dvd_input_t file_open(void *priv, dvd_logger_cb *logcb,
     return NULL;
   }
 
+  if (stream_cb != NULL){
+      dev->stream_cb = stream_cb;
+      return dev;
+  }
+
   /* Open the device */
 #if defined(_WIN32)
   dev->fd = open_win32(target, O_RDONLY | O_BINARY);
@@ -256,6 +264,16 @@ static int file_seek(dvd_input_t dev, int blocks)
 {
   off_t pos;
 
+  if (dev->stream_cb != NULL) {
+      if (dev->stream_cb->pf_seek == NULL)
+      {
+          DVDReadLog(dev->priv, dev->logcb, DVD_LOGGER_LEVEL_WARN, "ded");
+          return 0;
+      }
+      dev->stream_cb->pf_seek(dev->priv, (off_t)blocks * (off_t)DVD_VIDEO_LB_LEN);
+      return blocks;
+  }
+
   pos = lseek(dev->fd, (off_t)blocks * (off_t)DVD_VIDEO_LB_LEN, SEEK_SET);
   if(pos < 0) {
     return pos;
@@ -284,7 +302,11 @@ static int file_read(dvd_input_t dev, void *buffer, int blocks,
   bytes = 0;
 
   while(len > 0) {
-    ssize_t ret = read(dev->fd, ((char*)buffer) + bytes, len);
+    ssize_t ret;
+    if (dev->stream_cb != NULL)
+        ret = dev->stream_cb->pf_read(dev->priv, ((char*)buffer) + bytes, len);
+    else
+        ret = read(dev->fd, ((char*)buffer) + bytes, len);
 
     if(ret < 0) {
       /* One of the reads failed, too bad.  We won't even bother
@@ -297,7 +319,9 @@ static int file_read(dvd_input_t dev, void *buffer, int blocks,
       /* Nothing more to read.  Return all of the whole blocks, if any.
        * Adjust the file position back to the previous block boundary. */
       off_t over_read = -(bytes % DVD_VIDEO_LB_LEN);
+      assert(false);
       off_t pos = lseek(dev->fd, over_read, SEEK_CUR);
+      //off_t pos = file_seek(dev, over_read);
       if(pos % 2048 != 0)
           DVDReadLog(dev->priv, dev->logcb, DVD_LOGGER_LEVEL_WARN,
                      "lseek not multiple of 2048! Something is wrong!");
-- 
